/* Motion Extractor - EditorWindow Stylesheet */
/* Supports both Dark and Light Unity themes */

.root-container {
    padding: 8px;
}

/* Header */
.header {
    padding: 12px;
    margin-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(128, 128, 128, 0.3);
}

.title {
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.subtitle {
    font-size: 11px;
    color: rgba(180, 180, 180, 0.8);
}

/* Sections */
.section {
    margin: 4px 0;
    padding: 8px;
    border-radius: 4px;
    background-color: rgba(128, 128, 128, 0.05);
}

.section-title {
    font-size: 13px;
    -unity-font-style: bold;
    margin-bottom: 6px;
    padding-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(128, 128, 128, 0.2);
}

/* Fields */
.field-label {
    -unity-font-style: bold;
    font-size: 12px;
    margin-bottom: 2px;
}

.hint-text {
    font-size: 10px;
    color: rgba(180, 180, 180, 0.6);
    margin-top: 2px;
    margin-left: 4px;
}

/* Radio Group */
.radio-group {
    margin: 4px 0;
}

RadioButtonGroup {
    flex-direction: row;
}

RadioButton {
    margin-right: 12px;
}

/* Extract Button */
.action-section {
    margin: 12px 0;
    padding: 8px;
}

.extract-button {
    height: 36px;
    font-size: 14px;
    -unity-font-style: bold;
    background-color: rgba(60, 130, 200, 0.8);
    color: white;
    border-radius: 4px;
    border-width: 0;
}

.extract-button:hover {
    background-color: rgba(70, 150, 230, 0.9);
}

.extract-button:active {
    background-color: rgba(50, 110, 180, 0.9);
}

.extract-button:disabled {
    background-color: rgba(128, 128, 128, 0.3);
    color: rgba(200, 200, 200, 0.5);
}

/* Cancel Button */
.cancel-button {
    height: 28px;
    margin-top: 4px;
    background-color: rgba(200, 60, 60, 0.6);
    color: white;
    border-radius: 4px;
    border-width: 0;
}

.cancel-button:hover {
    background-color: rgba(220, 70, 70, 0.7);
}

/* Results */
.result-item {
    flex-direction: row;
    align-items: center;
    padding: 4px 8px;
    margin: 2px 0;
    border-radius: 3px;
    background-color: rgba(128, 128, 128, 0.08);
}

.result-icon {
    font-size: 14px;
    margin-right: 8px;
    width: 20px;
}

.result-name {
    flex-grow: 1;
    font-size: 12px;
}

.result-type {
    font-size: 10px;
    color: rgba(180, 180, 180, 0.7);
}

/* Button Row */
.button-row {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 8px;
}

.button-row Button {
    margin-left: 4px;
}

/* Progress */
ProgressBar {
    height: 24px;
    margin: 4px 0;
}
